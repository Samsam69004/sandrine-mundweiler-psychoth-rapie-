<!doctype html>
<html lang="fr">
  <%- include('../partials/head') %>
  <body>
    <%- include('../partials/header') %>

    <main class="section">
      <article class="container content-card">
        <p class="meta"><%= post.date %></p>
        <h1><%= post.title %></h1>
        <% if (post.image) { %>
        <figure class="post-image">
          <img src="/assets/images/<%= post.image %>" alt="<%= post.title %>" />
        </figure>
        <% } %>
        <% post.paragraphs.forEach((paragraph) => { %>
        <p><%= paragraph %></p>
        <% }) %>
        <p><a href="/blog">Retour au blog</a></p>
      </article>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
