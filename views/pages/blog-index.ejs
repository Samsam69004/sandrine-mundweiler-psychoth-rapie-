<!doctype html>
<html lang="fr">
  <%- include('../partials/head') %>
  <body>
    <%- include('../partials/header') %>

    <main class="section">
      <div class="container content-card">
        <p class="kicker">Blog</p>
        <h1>Ressources et reflexions cliniques</h1>
        <div class="blog-list">
          <% posts.forEach((post) => { %>
          <a class="blog-card-link" href="/blog/<%= post.slug %>">
            <article class="blog-item" aria-labelledby="post-<%= post.slug %>">
              <% if (post.image) { %>
              <figure class="blog-thumb">
                <img src="/assets/images/<%= post.image %>" alt="<%= post.title %>" />
              </figure>
              <% } %>
              <div>
                <p class="meta"><%= post.date %></p>
                <h2 id="post-<%= post.slug %>"><%= post.title %></h2>
                <p class="excerpt"><%= post.excerpt %></p>
              </div>
            </article>
          </a>
          <% }) %>
        </div>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
