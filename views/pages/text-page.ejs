<!doctype html>
<html lang="fr">
  <%- include('../partials/head') %>
  <body class="<%= bodyClass %> <%= activePath === '/a-propos' ? 'page-a-propos' : '' %>">
    <%- include('../partials/header') %>

    <main class="page-split">
      <div class="container split-grid">
        <article class="content-card">
          <% if (kicker && activePath !== '/approches-therapeutiques' && activePath !== '/experience-formation') { %>
          <p class="kicker"><%= kicker %></p>
          <% } %>
          <h1><%= heading %></h1>

          <% sections.forEach((section) => { %>
          <section class="prose-block">
            <% if (section.title) { %>
            <h2><%= section.title %></h2>
            <% } %>

            <% if (section.blocks) { %>
              <% section.blocks.forEach((block) => { %>
                <% if (block.type === 'emphasis') { %>
                <p class="text-emphasis"><%= block.text %></p>
                <% } else if (block.type === 'html') { %>
                <%- block.text %>
                <% } else { %>
                <p><%= block.text %></p>
                <% } %>
              <% }) %>
            <% } %>

            <% if (section.reviews) { %>
            <div class="reviews-grid">
              <% section.reviews.forEach((review) => { %>
              <article class="review-card review-card--<%= review.sourceClass || 'source' %>">
                <div class="review-card-head">
                  <div>
                    <p class="review-source"><%= review.source %></p>
                    <h3><%= review.author %></h3>
                  </div>
                  <p class="review-rating" aria-label="Note <%= review.rating %>"><%= review.rating %></p>
                </div>
                <p class="review-meta"><%= review.date %></p>
                <blockquote><%= review.quote %></blockquote>
              </article>
              <% }) %>
            </div>
            <% } %>

            <% if (section.paragraphs) { %>
              <% section.paragraphs.forEach((paragraph) => { %>
                <% if (typeof paragraph === 'string' && paragraph.indexOf('<a') !== -1) { %>
                <p><%- paragraph %></p>
                <% } else { %>
                <p><%= paragraph %></p>
                <% } %>
              <% }) %>
            <% } %>

            <% if (section.list) { %>
            <ul class="list-clean">
              <% section.list.forEach((item) => { %>
              <li><%= item %></li>
              <% }) %>
            </ul>
            <% } %>

            <% if (section.text) { %>
              <div><%- section.text.replace(/\n/g, '<br/>') %></div>
            <% } %>
          </section>
          <% }) %>

          <% if (activePath === '/approches-therapeutiques') { %>
          <a class="apsyse-showcase apsyse-showcase-link" href="https://apsyse.com/" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le site APsySE dans un nouvel onglet">
            <figure>
              <img src="/assets/images/apsyse.jpg" alt="Logo ApsySE, méthode d'analyse psycho somato énergétique" loading="lazy" />
              <figcaption>
                Logo ApsySE - analyse psycho somato énergétique, méthode utilisée dans l'accompagnement thérapeutique.
              </figcaption>
            </figure>
          </a>
          <% } %>

          <% if (activePath === '/experience-formation') { %>
          <a class="ff2p-showcase ff2p-showcase-link" href="https://www.ff2p.fr/" target="_blank" rel="noopener noreferrer" aria-label="Ouvrir le site de la FF2P dans un nouvel onglet">
            <figure>
              <img src="/assets/images/FF2P.jpg" alt="Logo de la FF2P, Fédération Française de Psychothérapie et Psychanalyse" loading="lazy" />
              <figcaption>
                Membre de la FF2P - Fédération Française de Psychothérapie et Psychanalyse.
              </figcaption>
            </figure>
          </a>
          <% } %>
        </article>

        <aside class="photo-panel">
          <figure class="portrait">
            <picture>
              <source type="image/webp" srcset="/assets/images/responsive/sandrine-400.webp 400w, /assets/images/responsive/sandrine-800.webp 800w, /assets/images/responsive/sandrine-1200.webp 1200w" sizes="(max-width: 600px) 90vw, 400px">
              <img src="/assets/images/responsive/sandrine-800.jpg" srcset="/assets/images/responsive/sandrine-400.jpg 400w, /assets/images/responsive/sandrine-800.jpg 800w, /assets/images/responsive/sandrine-1200.jpg 1200w" sizes="(max-width: 600px) 90vw, 400px" alt="Sandrine Mundweiler" loading="lazy" />
            </picture>
          </figure>
        </aside>
      </div>
    </main>

    <%- include('../partials/footer') %>
  </body>
</html>
