<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Accueil Sandrine Mundweiler">
      Sandrine Mundweiler
      <small>Therapie psychocorporelle - Lyon 6</small>
    </a>
    <button class="menu-toggle" aria-expanded="false" aria-controls="menu-principal">Menu</button>
    <nav id="menu-principal" class="site-nav" aria-label="Navigation principale">
      <ul>
        <% navLinks.forEach((link) => { %>
        <li>
          <a href="<%= link.href %>" <%= activePath === link.href ? 'aria-current="page"' : '' %>><%= link.label %></a>
        </li>
        <% }) %>
      </ul>
    </nav>
  </div>
</header>
